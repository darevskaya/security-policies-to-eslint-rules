{
  "name": "security-policies-to-eslint-rules",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch server/index.ts",
    "lint": "eslint . --ignore-pattern \"examples/*/bad.*\"",
    "typecheck": "tsc -p . && tsc -p examples",
    "test": "vitest run"
  },
  "dependencies": {
    "express": "5.2.1",
    "express-handlebars": "9.0.1"
  },
  "devDependencies": {
    "@html-eslint/eslint-plugin": "0.66.1",
    "@html-eslint/parser": "0.66.1",
    "@types/estree": "1.0.9",
    "@types/express": "5.0.6",
    "@types/node": "26.6.4",
    "@types/trusted-types": "2.0.7",
    "@typescript-eslint/utils": "8.71.0",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "jiti": "2.7.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.3"
  }
}
